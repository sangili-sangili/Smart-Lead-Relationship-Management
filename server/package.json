{
  "name": "leadflow-crm-server",
  "version": "1.0.0",
  "description": "LeadFlow CRM Backend REST API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/migrations/runner.js up",
    "migrate:up": "node src/migrations/runner.js up",
    "migrate:down": "node src/migrations/runner.js down",
    "migrate:status": "node src/migrations/runner.js status",
    "seed": "node src/migrations/seed.js",
    "test": "jest --detectOpenHandles --runInBand --forceExit"
  },
  "keywords": [
    "crm",
    "express",
    "mongodb",
    "jwt",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/tests/**/*.test.js"
    ]
  }
}
